{
  "name": "kayn-shipwright",
  "productName": "Kayn Shipwright",
  "version": "2.0.1",
  "private": true,
  "description": "Offline Starsector ship layout editor",
  "main": "main.cjs",
  "scripts": {
    "build": "tsc --noEmit && node build.mjs",
    "start": "npm run build && electron .",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:persistence": "node --experimental-strip-types --test tests/source-format.test.ts tests/save.test.ts tests/save-crash.test.ts tests/recovery-writer.test.ts tests/recovery-disk.test.ts tests/workspace.test.ts",
    "test:ui": "node tests/studio-ui.cjs",
    "package": "npm run build && node scripts/package-release.cjs",
    "test:references": "node tests/references.cjs",
    "test:classes": "node tests/classes.cjs",
    "test:geometry": "node tests/geometry-ui.cjs",
    "test:session": "node tests/workspace-ui.cjs",
    "test:package": "node tests/package.cjs",
    "assets:local": "node scripts/import-local-assets.cjs",
    "test:packaged": "node tests/packaged.cjs",
    "test:regressions": "node tests/audit-regressions.cjs",
    "test:scaling": "node tests/scaling-ui.cjs",
    "test:aim": "node tests/aim-contract.cjs",
    "diagnose:aim": "node tests/aim-diagnosis.cjs",
    "test:imports": "node tests/import-ui.cjs",
    "test:source-browser": "node tests/source-browser-ui.cjs",
    "test:startup": "node tests/startup-ui.cjs",
    "test:drops": "node tests/drop-ui.cjs",
    "test:workspace": "node tests/workspace-ui.cjs",
    "test:close": "node tests/close-ui.cjs",
    "test:soak": "node tests/release-soak.cjs",
    "test:memory": "node tests/recovery-memory-ui.cjs",
    "test:artwork": "node tests/state-artwork-ui.cjs"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "45.2.1",
    "esbuild": "0.28.2",
    "playwright": "1.64.1",
    "typescript": "7.0.2"
  },
  "type": "module",
  "overrides": {
    "glob": "14.0.3",
    "minimatch": "11.0.3"
  }
}
